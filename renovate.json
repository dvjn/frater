{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Keep SSE types compatible with rmcp; revisit when rmcp upgrades sse-stream.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["sse-stream"],
      "allowedVersions": "<0.3.0"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools"
    },
    {
      "description": "What ships in the binary gets the deps type, which release-please lists under Dependencies",
      "matchManagers": ["cargo"],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["rust"],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security updates are listed under Bug Fixes",
    "semanticCommitType": "fix",
    "semanticCommitScope": "deps"
  }
}
