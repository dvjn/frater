{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting",
    "customManagers:githubActionsVersions"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Keep SSE types compatible with rmcp; revisit when rmcp upgrades sse-stream.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["sse-stream"],
      "allowedVersions": "<0.3.0"
    },
    {
      "description": "Crate updates share one PR, which also runs cargo update so indirect crates get refreshed",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies",
      "postUpgradeTasks": {
        "commands": ["cargo update"],
        "fileFilters": ["Cargo.lock"],
        "executionMode": "branch",
        "installTools": { "rust": {} }
      }
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The mise version pinned in CI updates with the other dev tools",
      "matchPackageNames": ["jdx/mise"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools"
    },
    {
      "description": "What ships in the binary gets the deps type, which release-please lists under Dependencies",
      "matchManagers": ["cargo"],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["rust"],
      "semanticCommitType": "deps",
      "semanticCommitScope": null
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security updates are listed under Bug Fixes",
    "semanticCommitType": "fix",
    "semanticCommitScope": "deps"
  }
}
