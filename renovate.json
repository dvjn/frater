{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Keep SSE types compatible with rmcp; revisit when rmcp upgrades sse-stream.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["sse-stream"],
      "allowedVersions": "<0.3.0"
    },
    {
      "description": "Crate updates share one PR, which also runs cargo update so indirect crates get refreshed",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies",
      "postUpgradeTasks": {
        "commands": ["cargo update"],
        "fileFilters": ["Cargo.lock"],
        "executionMode": "branch",
        "installTools": { "rust": {} }
      }
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools"
    }
  ]
}
